---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
import brandMark from '../../public/favicon.svg?raw';

const brandSvg = brandMark.replace(
  '<svg ',
  '<svg aria-hidden="true" focusable="false" ',
);
---

<header data-site-header class={styles['site-header']}>
  <div class:list={[styles['container'], styles['header-inner']]}>
    <a
      class={styles['brand']}
      href="#top"
      aria-label="Corbin Crutchley, back to top"
    >
      <span class={styles['brand-mark']} set:html={brandSvg} />
      <span>Corbin Crutchley</span>
    </a>
    <nav class={styles['main-nav']} aria-label="Main navigation">
      <div class={styles['nav-links']}>
        <a href="#work" data-nav>Work</a>
        <a href="#consulting" data-nav>Consulting</a>
        <a href="#writing" data-nav>Writing</a>
        <a href="#open-source" data-nav>Open source</a>
        <a href="#speaking" data-nav>Speaking</a>
        <a class={styles['contact-nav']} href="https://cal.com/crutchcorn/"
          >Let’s talk <Icon name="out"
        /></a>
      </div>
    </nav>
  </div>
</header>
