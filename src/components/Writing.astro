---
import styles from '../styles/site.module.scss';
import writingStyles from '../styles/writing.module.scss';
import Icon from './Icon.astro';

const books = [
  {
    title: 'The Framework Field Guide',
    category: 'Frameworks',
    description:
      'A free, practical way to learn React, Angular, and Vue together. Build mental models that travel with you from one framework to the next.',
    href: 'https://framework.guide',
    image: '/assets/framework-field-guide.png',
    width: 1200,
    height: 675,
    alt: 'The Framework Field Guide artwork, with a forest landscape and Angular, React, and Vue symbols',
  },
  {
    title: 'The Big Bot Builders',
    category: 'AI',
    status: 'Early access',
    description:
      'Explore how modern AI models learn, generate responses, use tools, and remember information, from first principles to practical applications.',
    href: 'https://bigbot.builders',
    image: '/assets/big-bot-builders.png',
    width: 1920,
    height: 1080,
    alt: 'The Big Bot Builders early access artwork showing a robot under construction',
  },
  {
    title: 'The Art of Accessibility',
    category: 'Accessibility',
    description:
      'Learn to build more accessible web applications. Make thoughtful choices that help more people use the things you create.',
    href: 'https://a11y.art',
    image: '/assets/art-of-accessibility.png',
    width: 1920,
    height: 1080,
    alt: 'The Art of Accessibility artwork showing people outside a café, including a wheelchair user and a person with a white cane',
  },
];
---

<section
  class:list={[styles['section'], styles['container']]}
  id="writing"
  aria-labelledby="writing-heading"
  tabindex="-1"
>
  <div class={styles['section-intro']} data-reveal>
    <p class:list={[styles['eyebrow'], styles['section-label']]}>
      <span class={styles['index']} aria-hidden="true">03</span> Writing
    </p>
    <div>
      <h2 id="writing-heading">
        Understanding is<br />a thing we can <em>share.</em>
      </h2>
      <p>
        I write to make the next difficult decision a little easier. Sometimes
        that’s understanding a framework. Sometimes it’s understanding the
        person on the other side of a conversation.
      </p>
    </div>
  </div>
  <h3 class:list={[styles['eyebrow'], writingStyles['group-heading']]}>
    Books
  </h3>
  <div class={writingStyles['books-grid']}>
    {books.map((book) => <article
      class={writingStyles['book-card']}
      data-reveal
    >
      <a
        class={writingStyles['book-image-link']}
        href={book.href}
        aria-label={`Read ${book.title}`}
      >
        <img
          src={book.image}
          width={book.width}
          height={book.height}
          alt={book.alt}
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class={writingStyles['book-caption']}>
        <p class:list={[styles['eyebrow'], writingStyles['book-category']]}>
          {book.category}{'status' in book && (
            <><span aria-hidden="true"> · </span
              ><span class={styles['sr-only']}>, </span>{book.status}</>
          )}
        </p>
        <h4>{book.title}</h4>
        <p class={writingStyles['book-description']}>{book.description}</p>
        <a
          class:list={[styles['text-link'], writingStyles['book-link']]}
          href={book.href}
        >
          <span>Read the book</span>
          <span class={styles['sr-only']}>: {book.title}</span>
          <Icon name="out" />
        </a>
      </div>
    </article>)}
  </div>
  <div class={writingStyles['essays-group']}>
    <h3 class:list={[styles['eyebrow'], writingStyles['group-heading']]}>
      Essays on leadership & teams
    </h3>
    <div class={writingStyles['collections-grid']}>
      <a
        class={styles['collection-link']}
        href="https://playfulprogramming.com/collections/harsh-leadership-truths/"
        data-reveal
      >
        <div class={styles['collection-top']}>
          <span class={styles['eyebrow']}>Essay collection</span
          ><Icon name="out" />
        </div>
        <h4 class={writingStyles['collection-title']}>
          Harsh Leadership Truths
        </h4>
        <p>
          The uncomfortable parts of leadership: inherited systems, changing
          responsibilities, and growing alongside the team.
        </p>
      </a>
      <a
        class={styles['collection-link']}
        href="https://playfulprogramming.com/collections/pragmatic-advice-for-teams/"
        data-reveal
      >
        <div class={styles['collection-top']}>
          <span class={styles['eyebrow']}>Essay collection</span
          ><Icon name="out" />
        </div>
        <h4 class={writingStyles['collection-title']}>
          Pragmatic Advice for Teams
        </h4>
        <p>
          Thoughtful tradeoffs, shared context, and practical ways to help
          people work well together.
        </p>
      </a>
    </div>
    <div class={writingStyles['essays-grid']}>
      <a
        class={styles['article-link']}
        href="https://playfulprogramming.com/posts/working-with-crutchcorn/"
      >
        <div class={styles['od-field']}>
          <span class={styles['article-type']}
            >Start here<span aria-hidden="true"> · </span
            ><span class={styles['sr-only']}>, </span>Leadership</span
          >
          <h4 class={writingStyles['essay-title']}>Working with Me</h4>
        </div>
        <Icon name="out" />
      </a>
      <a
        class={styles['article-link']}
        href="https://playfulprogramming.com/posts/how-to-communicate"
      >
        <div class={styles['od-field']}>
          <span class={styles['article-type']}
            >On teams<span aria-hidden="true"> · </span
            ><span class={styles['sr-only']}>, </span>Communication</span
          >
          <h4 class={writingStyles['essay-title']}>How to Communicate</h4>
        </div>
        <Icon name="out" />
      </a>
    </div>
  </div>
</section>
