---
import { Picture } from 'astro:assets';
import frameworkFieldGuide from '../assets/framework-field-guide.png';
import bigBotBuilders from '../assets/big-bot-builders.png';
import artOfAccessibility from '../assets/art-of-accessibility.png';
import styles from '../styles/site.module.scss';
import writingStyles from '../styles/writing.module.scss';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const books = [
  {
    title: 'The Framework Field Guide',
    description: 'A free guide to learning React, Angular, and Vue together.',
    href: 'https://framework.guide',
    image: frameworkFieldGuide,
    alt: 'The Framework Field Guide artwork, with a forest landscape and Angular, React, and Vue symbols',
  },
  {
    title: 'The Big Bot Builders',
    status: 'Early access',
    description:
      'How AI models learn, generate responses, use tools, and remember information.',
    href: 'https://bigbot.builders',
    image: bigBotBuilders,
    alt: 'The Big Bot Builders early access artwork showing a robot under construction',
  },
  {
    title: 'The Art of Accessibility',
    description: 'A guide to building accessible web applications.',
    href: 'https://a11y.art',
    image: artOfAccessibility,
    alt: 'The Art of Accessibility artwork showing people outside a café, including a wheelchair user and a person with a white cane',
  },
];

// Match the grid's columns, page gutters, and the frame around each cover.
const bookImageSizes =
  '(max-width: 374px) calc(100vw - 90px), (max-width: 767px) calc(100vw - 106px), (max-width: 1023px) calc((100vw - 254px) / 3), (max-width: 1327px) calc((100vw - 334px) / 3), 332px';
---

<section
  class:list={[styles['section'], styles['container']]}
  id="writing"
  aria-labelledby="writing-heading"
  tabindex="-1"
>
  <SectionHeading
    id="writing-heading"
    description="I write to make the next difficult decision a little easier. Sometimes that’s understanding a framework. Sometimes it’s understanding the person on the other side of a conversation."
    >Writing</SectionHeading
  >
  <div data-illustration-trigger>
    <h3
      class:list={[
        writingStyles['group-heading'],
        writingStyles['books-heading'],
      ]}
    >
      <span>Books</span>
      <svg
        class={writingStyles['book-study']}
        viewBox="0 0 88 44"
        width="88"
        height="44"
        fill="none"
        aria-hidden="true"
        focusable="false"
        data-illustration
      >
        <path class={writingStyles['study-guide']} d="M4 37h80M44 3v38" />
        <path
          class={writingStyles['study-ink']}
          d="M44 13C33 5 19 6 10 9v25c10-3 23-2 34 4 11-6 24-7 34-4V9c-9-3-23-4-34 4Zm0 0v25"
          data-draw
        />
        <path
          class={writingStyles['study-ink']}
          d="M18 15c7-1 13 0 19 3m-19 4c7-1 13 0 19 3"
          data-draw
        />
        <path
          class={writingStyles['study-ink']}
          d="M51 18c6-3 12-4 19-3m-19 10c6-3 12-4 19-3"
          data-draw
        />
        <path class={writingStyles['study-pencil']} d="M47 40c9-4 20-6 30-4" />
      </svg>
    </h3>
    <div class={writingStyles['books-grid']}>
      {books.map((book) => <article class={writingStyles['book-card']}>
        <a
          class={writingStyles['book-image-link']}
          href={book.href}
          aria-label={`Read ${book.title}`}
        >
          <Picture
            src={book.image}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            widths={[240, 320, 480, 640, 960, 1280, 1440]}
            sizes={bookImageSizes}
            alt={book.alt}
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class={writingStyles['book-caption']}>
          <h4>{book.title}</h4>
          {'status' in book && <p class={writingStyles['book-status']}>
            {book.status}
          </p>}
          <p class={writingStyles['book-description']}>{book.description}</p>
          <a
            class:list={[styles['text-link'], writingStyles['book-link']]}
            href={book.href}
          >
            <span>Read the book</span>
            <span class={styles['sr-only']}>: {book.title}</span>
            <Icon name="out" />
          </a>
        </div>
      </article>)}
    </div>
  </div>
  <div class={writingStyles['essays-group']}>
    <h3 class={writingStyles['group-heading']}>Essays on leadership & teams</h3>
    <div class={writingStyles['collections-grid']}>
      <a
        class:list={[styles['collection-link'], writingStyles['collection']]}
        href="https://playfulprogramming.com/collections/harsh-leadership-truths/"
      >
        <div class={styles['collection-top']}>
          <Icon name="out" />
        </div>
        <h4 class={writingStyles['collection-title']}>
          Harsh Leadership Truths
        </h4>
        <p>
          Essays on inherited systems, changing responsibilities, and team
          growth.
        </p>
      </a>
      <a
        class:list={[styles['collection-link'], writingStyles['collection']]}
        href="https://playfulprogramming.com/collections/pragmatic-advice-for-teams/"
      >
        <div class={styles['collection-top']}>
          <Icon name="out" />
        </div>
        <h4 class={writingStyles['collection-title']}>
          Pragmatic Advice for Teams
        </h4>
        <p>Essays on tradeoffs, shared context, and working together.</p>
      </a>
    </div>
    <div class={writingStyles['essays-grid']}>
      <a
        class:list={[styles['article-link'], writingStyles['essay']]}
        href="https://playfulprogramming.com/posts/working-with-crutchcorn/"
      >
        <span class={writingStyles['essay-mark']} aria-hidden="true">↳</span>
        <div class={styles['od-field']}>
          <h4 class={writingStyles['essay-title']}>Working with Me</h4>
        </div>
        <Icon name="out" />
      </a>
      <a
        class:list={[styles['article-link'], writingStyles['essay']]}
        href="https://playfulprogramming.com/posts/how-to-communicate"
      >
        <span class={writingStyles['essay-mark']} aria-hidden="true">↳</span>
        <div class={styles['od-field']}>
          <h4 class={writingStyles['essay-title']}>How to Communicate</h4>
        </div>
        <Icon name="out" />
      </a>
    </div>
  </div>
</section>
