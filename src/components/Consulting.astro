---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
---

<section
  class:list={[styles['section'], styles['consulting-section']]}
  id="consulting"
  aria-labelledby="consulting-heading"
  tabindex="-1"
>
  <div class={styles['container']}>
    <div class={styles['section-intro']} data-reveal>
      <h2 id="consulting-heading">Consulting</h2>
    </div>
    <div class:list={[styles['od-grid'], styles['service-grid']]}>
      <article class={styles['service']} data-reveal>
        <h3>Architecture</h3>
        <p>
          Architecture reviews, prototypes, and technical recommendations with
          documented tradeoffs.
        </p>
      </article>
      <article class={styles['service']} data-reveal>
        <h3>Engineering leadership</h3>
        <p>Release practices, quality, hiring, and team communication.</p>
      </article>
      <article class={styles['service']} data-reveal>
        <h3>Developer education</h3>
        <p>Documentation, technical writing, and training for developers.</p>
      </article>
    </div>
    <div class={styles['consulting-history']}>
      <div class={styles['history-top']}>
        <p>Selected consulting clients through OceanBit</p>
        <p>
          Founder<span aria-hidden="true"> · </span
          ><span class={styles['sr-only']}>, </span>Feb 2020 – Present
        </p>
      </div>
      <ul
        class={styles['client-list']}
        role="list"
        aria-label="Past OceanBit clients"
      >
        <li>
          <a href="https://clerk.com/">
            <img
              src="/assets/clients/clerk.svg"
              width="110"
              height="32"
              alt="Clerk"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
        <li>
          <a href="https://astro.build/">
            <img
              src="/assets/clients/astro.svg"
              width="138"
              height="48"
              alt="Astro"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
        <li>
          <a href="https://stackblitz.com/">
            <img
              src="/assets/clients/stackblitz.svg"
              width="156"
              height="32"
              alt="StackBlitz"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
        <li>
          <a href="https://www.replay.io/">
            <img
              src="/assets/clients/replay.svg"
              width="125"
              height="34"
              alt="Replay.io"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      </ul>
      <div class={styles['consulting-bottom']}>
        <p>
          Technical writing and documentation restructuring for teams building
          developer tools.
        </p>
        <a class={styles['text-link']} href="https://oceanbit.dev/"
          ><span>OceanBit</span><Icon name="out"
        /></a>
      </div>
    </div>
  </div>
</section>
