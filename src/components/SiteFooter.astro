---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
---

<footer class={styles['site-footer']}>
  <img
    class={styles['footer-signature']}
    src="/assets/signature.svg"
    width="960"
    height="192"
    alt="Corbin Crutchley"
    loading="lazy"
    decoding="async"
  />
  <div class={styles['footer-links']}>
    <a href="https://github.com/crutchcorn">GitHub <Icon name="out" /></a>
    <a href="https://www.linkedin.com/in/corbincrutchley/"
      >LinkedIn <Icon name="out"
    /></a>
    <a href="#top">Back to top <Icon name="up" /></a>
  </div>
</footer>
