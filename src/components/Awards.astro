---
import styles from '../styles/site.module.scss';
import awards from '../styles/awards.module.scss';
---

<section
  class:list={[styles['container'], awards['section']]}
  id="awards"
  aria-labelledby="awards-heading"
>
  <div class={awards['shelf']}>
    <h2 id="awards-heading" class={awards['label']}>Awards</h2>
    <ul class={awards['awards-list']}>
      <li>
        <a
          class={awards['entry']}
          href="https://stars.github.com/profiles/crutchcorn/"
        >
          <img
            class={awards['mark']}
            src="/assets/awards/github.svg"
            width="40"
            height="40"
            alt=""
          />
          <span class={awards['name']}>GitHub Star</span>
        </a>
      </li>
      <li>
        <a
          class={awards['entry']}
          href="https://mvp.microsoft.com/en-US/MVP/profile/0ab92fa3-8847-4304-8104-0cdfc5b79ed8"
        >
          <img
            class={awards['mark']}
            src="/assets/awards/microsoft.svg"
            width="40"
            height="40"
            alt=""
          />
          <span class={awards['name']}>Microsoft MVP</span>
        </a>
      </li>
      <li>
        <a
          class={awards['entry']}
          href="https://www.jetbrains.com/lp/jetbrains-community-contributor/"
        >
          <img
            class={awards['mark']}
            src="/assets/awards/jetbrains.svg"
            width="40"
            height="40"
            alt=""
          />
          <span class={awards['name']}>JetBrains Community Contributor</span>
        </a>
      </li>
    </ul>
  </div>
</section>
