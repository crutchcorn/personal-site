---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
---

<section
  class:list={[styles['section'], styles['oss-section'], styles['container']]}
  id="open-source"
  aria-labelledby="oss-heading"
  tabindex="-1"
>
  <div class={styles['section-intro']} data-reveal>
    <h2 id="oss-heading">Open source</h2>
  </div>
  <div class:list={[styles['od-grid'], styles['project-grid']]}>
    <article class={styles['project']} data-reveal>
      <h3>TanStack</h3>
      <p>
        I lead maintenance of Form, Store, and Config, and contribute to Query
        and Table.
      </p>
      <div
        class={styles['project-links']}
        role="group"
        aria-label="TanStack projects"
      >
        <a class={styles['text-link']} href="https://tanstack.com/form"
          ><span><span class={styles['sr-only']}>TanStack </span>Form</span
          ><Icon name="out"
        /></a>
        <a class={styles['text-link']} href="https://tanstack.com/store"
          ><span><span class={styles['sr-only']}>TanStack </span>Store</span
          ><Icon name="out"
        /></a>
        <a class={styles['text-link']} href="https://tanstack.com/config"
          ><span><span class={styles['sr-only']}>TanStack </span>Config</span
          ><Icon name="out"
        /></a>
      </div>
    </article>
    <article class={styles['project']} data-reveal>
      <h3>Redux</h3>
      <p>
        I ported Redux integrations to Angular and Vue and contribute across the
        Redux ecosystem.
      </p>
      <div
        class={styles['project-links']}
        role="group"
        aria-label="Redux integrations"
      >
        <a
          class={styles['text-link']}
          href="https://github.com/reduxjs/angular-redux"
          ><span>Angular Redux</span><Icon name="out"
        /></a>
        <a
          class={styles['text-link']}
          href="https://github.com/reduxjs/vue-redux"
          ><span>Vue Redux</span><Icon name="out"
        /></a>
      </div>
    </article>
    <article class={styles['project']} data-reveal>
      <h3>Plop</h3>
      <p>
        I maintain Plop, a tool for generating files from reusable templates.
      </p>
      <div class={styles['project-links']}>
        <a class={styles['text-link']} href="https://plopjs.com/">
          <span>Plop website</span><Icon name="out" />
        </a>
      </div>
    </article>
  </div>
  <div class={styles['more-projects']}>
    <div class={styles['maintenance-projects']}>
      <p>Also helping maintain</p>
      <div class={styles['od-cluster']}>
        <a class={styles['text-link']} href="https://github.com/jimp-dev/"
          ><span>Jimp</span><Icon name="out"
        /></a>
        <a class={styles['text-link']} href="https://cli-testing.com/"
          ><span>CLI Testing Library</span><Icon name="out"
        /></a>
        <a class={styles['text-link']} href="https://github.com/Vibrant-Colors/"
          ><span>Node Vibrant</span><Icon name="out"
        /></a>
      </div>
    </div>
    <a class={styles['text-link']} href="https://github.com/crutchcorn"
      ><span>Find me on GitHub</span><Icon name="out"
    /></a>
  </div>
</section>
