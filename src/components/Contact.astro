---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
---

<section
  class={styles['contact-section']}
  id="contact"
  aria-labelledby="contact-heading"
  tabindex="-1"
>
  <div class={styles['container']}>
    <div class={styles['contact-grid']}>
      <div class={styles['contact-title']} data-reveal>
        <h2 id="contact-heading">Contact</h2>
        <svg
          class={styles['contact-drawing']}
          viewBox="0 0 420 92"
          width="420"
          height="92"
          aria-hidden="true"
          focusable="false"
          fill="none"
        >
          <path
            class={styles['contact-guide']}
            d="M8 44h404M32 8v76M240 8v76M8 12h8m-4-4v8M404 76h8m-4-4v8"
          />
          <path
            d="M32 44h78c28 0 28-24 56-24h38c28 0 28 48 56 48h42c28 0 28-24 56-24h40M32 52h78c28 0 28-24 56-24h34c28 0 28 48 56 48h50c28 0 28-24 56-24h36"
          />
          <circle cx="32" cy="48" r="8" />
          <path d="m387 34 14 14-14 14" />
        </svg>
      </div>
      <div class={styles['contact-copy']}>
        <p>For consulting or engineering leadership work, book a call.</p>
        <a class={styles['button']} href="https://cal.com/crutchcorn/"
          >Book a call <Icon name="out"
        /></a>
      </div>
    </div>
  </div>
</section>
