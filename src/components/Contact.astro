---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
---

<section
  class={styles['contact-section']}
  id="contact"
  aria-labelledby="contact-heading"
  tabindex="-1"
>
  <div class={styles['container']}>
    <div class={styles['contact-grid']}>
      <h2 id="contact-heading" data-reveal>Contact</h2>
      <div class={styles['contact-copy']}>
        <p>For consulting or engineering leadership work, book a call.</p>
        <a class={styles['button']} href="https://cal.com/crutchcorn/"
          >Book a call <Icon name="out"
        /></a>
      </div>
    </div>
  </div>
</section>
