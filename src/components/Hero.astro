---
import styles from '../styles/site.module.scss';
import hero from '../styles/hero.module.scss';
import Icon from './Icon.astro';

const frameLines = ['M14 92H446', 'M14 372H446', 'M88 18V442', 'M372 18V442'];
const frameNodes = [
  { cx: 14, cy: 92 },
  { cx: 446, cy: 92 },
  { cx: 14, cy: 372 },
  { cx: 446, cy: 372 },
  { cx: 88, cy: 18 },
  { cx: 88, cy: 442 },
  { cx: 372, cy: 18 },
  { cx: 372, cy: 442 },
];
---

<section
  class:list={[hero['hero'], styles['container']]}
  aria-labelledby="hero-heading"
>
  <div class={hero['grid']}>
    <div class={hero['introduction']}>
      <h1 id="hero-heading">
        <span class={hero['opening-quote']} aria-hidden="true">“</span>
        <span class={hero['headline-line']}>I’m thinking about the</span>
        <span class={hero['headline-line']}>
          people <span class={hero['accent']}>behind</span>
        </span>
        <span class={hero['headline-line']}>
          the screen<span class={hero['accent']}>.</span
          ><span class={hero['closing-quote']} aria-hidden="true">”</span>
        </span>
      </h1>
      <p class={styles['hero-description']}>
        <b>Hi, I’m Corbin Crutchley.</b> I’m an engineering leader, consultant,
        author, and open-source maintainer.
      </p>
      <div class={styles['hero-actions']}>
        <a class={styles['button']} href="https://cal.com/crutchcorn/"
          >Book a call <Icon name="out"
        /></a>
        <a class={styles['text-link']} href="#work"
          ><span>Work history</span><Icon name="down"
        /></a>
      </div>
    </div>
    <figure class={hero['portrait']}>
      <div class={hero['drawing']} data-illustration-trigger>
        <svg
          class={hero['connections']}
          viewBox="0 0 460 460"
          aria-hidden="true"
          focusable="false"
          data-illustration
          data-illustration-on-visible
        >
          <g class={hero['guides']}>
            <circle cx="230" cy="230" r="200" />
            <path
              d="M58 44h16m-8-8v16M390 44h16m-8-8v16M58 394h16m-8-8v16M390 394h16m-8-8v16"
            />
          </g>
          <g class={hero['routes']}>
            {frameLines.map((d) => (
              <path d={d} data-draw />
            ))}
          </g>
          <g class={hero['nodes']}>
            {frameNodes.map(({ cx, cy }) => (
              <circle cx={cx} cy={cy} r="4.5" data-illustration-node />
            ))}
          </g>
        </svg>
        <div class={hero['photo']}>
          <img
            src="/assets/corbin_present.png"
            width="867"
            height="1086"
            alt="Corbin Crutchley presenting on stage, wearing glasses and a TanStack shirt"
            fetchpriority="high"
          />
        </div>
      </div>
    </figure>
  </div>
</section>
