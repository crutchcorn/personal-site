---
import styles from '../styles/site.module.scss';
import hero from '../styles/hero.module.scss';
import Icon from './Icon.astro';
import {
  portraitGuides,
  portraitRegistration,
  portraitRoutes,
  portraitNodes,
} from '../data/portrait';
---

<section
  class:list={[hero['hero'], styles['container']]}
  aria-labelledby="hero-heading"
>
  <div class={hero['grid']}>
    <div class={hero['introduction']}>
      <h1 id="hero-heading">
        Technical <span>depth<span class={hero['period']}>.</span></span>
        Organizational
        <span>leadership<span class={hero['period']}>.</span></span>
      </h1>
      <p class={styles['hero-description']}>
        <b>Hi, I’m Corbin Crutchley.</b> I’m an engineering leader, consultant,
        author, and open-source maintainer.
      </p>
      <div class={styles['hero-actions']}>
        <a class={styles['button']} href="https://cal.com/crutchcorn/"
          >Book a call <Icon name="out"
        /></a>
        <a class={styles['text-link']} href="#work"
          ><span>Work history</span><Icon name="down"
        /></a>
      </div>
    </div>
    <figure class={hero['portrait']}>
      <div class={hero['drawing']} data-illustration-trigger>
        <svg
          class={hero['connections']}
          viewBox="0 0 460 460"
          aria-hidden="true"
          focusable="false"
          data-illustration
        >
          <g class={hero['guides']}>
            <path d={portraitGuides} />
            <circle cx="230" cy="230" r="204" />
            <path d={portraitRegistration} />
          </g>
          <g class={hero['routes']}>
            {portraitRoutes.map((d) => (
              <path d={d} data-draw />
            ))}
          </g>
          <g class={hero['nodes']}>
            {portraitNodes.map(({ cx, cy }) => (
              <circle cx={cx} cy={cy} r="7" data-illustration-node />
            ))}
          </g>
        </svg>
        <div class={hero['photo']}>
          <img
            class={styles['od-media']}
            src="/assets/corbin-profile.jpg"
            width="460"
            height="460"
            alt="Corbin Crutchley smiling, wearing glasses and a pink shirt"
            fetchpriority="high"
          />
        </div>
        <p class={hero['availability']}>Available for hire</p>
      </div>
      <figcaption class={hero['caption']}>
        <span class={hero['location-mark']} aria-hidden="true">↗</span>
        Sacramento, California
        <span class={hero['caption-rule']} aria-hidden="true"></span>
      </figcaption>
    </figure>
  </div>
</section>
