---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
---

<section
  class:list={[styles['hero'], styles['container']]}
  aria-labelledby="hero-heading"
>
  <div class={styles['hero-grid']}>
    <div data-reveal>
      <h1 id="hero-heading">Corbin Crutchley</h1>
      <p class={styles['hero-description']}>
        I’m an engineering leader, consultant, author, and open-source
        maintainer in Sacramento, California.
      </p>
      <div class={styles['hero-actions']}>
        <a class={styles['button']} href="https://cal.com/crutchcorn/"
          >Book a call <Icon name="out"
        /></a>
        <a class={styles['text-link']} href="#work"
          ><span>Work history</span><Icon name="down"
        /></a>
      </div>
    </div>
    <figure class={styles['portrait']} data-reveal>
      <div class={styles['portrait-frame']}>
        <img
          class={styles['od-media']}
          src="/assets/corbin-profile.jpg"
          width="460"
          height="460"
          alt="Corbin Crutchley smiling, wearing glasses and a pink shirt"
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>
</section>
