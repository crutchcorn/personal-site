---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
---

<section
  class:list={[styles['hero'], styles['container']]}
  aria-labelledby="hero-heading"
>
  <div class={styles['hero-grid']}>
    <div data-reveal>
      <h1 id="hero-heading">
        <span class={styles['hero-line']}>Thinking of</span>
        <span class={styles['hero-line']}><em>people</em> behind</span>
        <span class={styles['hero-line']}
          >the
          screen<span class={styles['period']} aria-hidden="true">.</span></span
        >
      </h1>
      <p class={styles['hero-description']}>
        <strong>I’m Corbin Crutchley.</strong> I help growing companies connect
        technical direction with the people who build, use, and depend on their
        software.
      </p>
      <div class={styles['hero-actions']}>
        <a class={styles['button']} href="https://cal.com/crutchcorn/"
          >Let’s build what’s next <Icon name="out"
        /></a>
        <a class={styles['text-link']} href="#work"
          ><span>Explore my work</span><Icon name="down"
        /></a>
      </div>
    </div>
    <figure class={styles['portrait']} data-reveal>
      <div class={styles['portrait-frame']}>
        <img
          class={styles['od-media']}
          src="/assets/corbin-profile.jpg"
          width="460"
          height="460"
          alt="Corbin Crutchley smiling, wearing glasses and a pink shirt"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <strong>Corbin Crutchley</strong>
        <span>Sacramento, CA, USA</span>
      </figcaption>
    </figure>
  </div>
  <div class={styles['hero-foot']}>
    <p>Over a decade of hands-on engineering.</p>
    <ul
      class={styles['chapter-links']}
      role="list"
      aria-label="Professional focus"
    >
      <li>OSS Developer</li>
      <li>Author</li>
      <li>Engineering Leader</li>
    </ul>
  </div>
</section>
