---
import styles from '../styles/site.module.scss';
import hero from '../styles/hero.module.scss';
import Icon from './Icon.astro';
---

<section
  class:list={[hero['hero'], styles['container']]}
  aria-labelledby="hero-heading"
>
  <div class={hero['grid']}>
    <div class={hero['introduction']} data-reveal>
      <h1 id="hero-heading">
        Corbin <span>Crutchley<span class={hero['period']}>.</span></span>
      </h1>
      <p class={styles['hero-description']}>
        I’m an engineering leader, consultant, author, and open-source
        maintainer in Sacramento, California.
      </p>
      <div class={styles['hero-actions']}>
        <a class={styles['button']} href="https://cal.com/crutchcorn/"
          >Book a call <Icon name="out"
        /></a>
        <a class={styles['text-link']} href="#work"
          ><span>Work history</span><Icon name="down"
        /></a>
      </div>
    </div>
    <figure class={hero['portrait']}>
      <div class={hero['drawing']}>
        <svg
          class={hero['connections']}
          viewBox="0 0 460 460"
          aria-hidden="true"
          focusable="false"
        >
          <g class={hero['guides']}>
            <path d="M0 92H460M0 368H460M92 0V460M368 0V460" />
            <circle cx="230" cy="230" r="204" />
            <path
              d="M16 16h16m-8-8v16M428 16h16m-8-8v16M16 444h16m-8-8v16M428 444h16m-8-8v16"
            />
          </g>
          <g class={hero['routes']}>
            <!-- Shared corner centers keep all four routes 12 units apart. -->
            <path
              d="M24 176h2a32 32 0 0 0 32-32v-16a76 76 0 0 1 76-76h192a76 76 0 0 1 76 76v212a76 76 0 0 1-76 76H154"
            />
            <path
              d="M24 188h2a44 44 0 0 0 44-44v-16a64 64 0 0 1 64-64h192a64 64 0 0 1 64 64v212a64 64 0 0 1-64 64H154"
            />
            <path
              d="M282 12a28 28 0 0 0 28 28h16a88 88 0 0 1 88 88v212a88 88 0 0 1-88 88H134a88 88 0 0 1-88-88v-74a36 36 0 0 0-36-36"
            />
            <path
              d="M294 12a16 16 0 0 0 16 16h16a100 100 0 0 1 100 100v212a100 100 0 0 1-100 100H134a100 100 0 0 1-100-100v-74a24 24 0 0 0-24-24"
            />
          </g>
          <g class={hero['nodes']}>
            <circle cx="24" cy="182" r="7" />
            <circle cx="288" cy="12" r="7" />
            <circle cx="154" cy="410" r="7" />
          </g>
        </svg>
        <div class={hero['photo']}>
          <img
            class={styles['od-media']}
            src="/assets/corbin-profile.jpg"
            width="460"
            height="460"
            alt="Corbin Crutchley smiling, wearing glasses and a pink shirt"
            fetchpriority="high"
          />
        </div>
      </div>
      <figcaption class={hero['caption']}>
        <span class={hero['location-mark']} aria-hidden="true">↗</span>
        Sacramento, California
        <span class={hero['caption-rule']} aria-hidden="true"></span>
      </figcaption>
    </figure>
  </div>
</section>
