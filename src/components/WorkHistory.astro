---
import styles from '../styles/site.module.scss';
import Icon from './Icon.astro';
import Dialog from './Dialog.astro';
import EarlyCareerList from './EarlyCareerList.astro';
import history from '../styles/work-history.module.scss';
import SectionHeading from './SectionHeading.astro';

const earlyCareerGroups = [
  {
    heading: 'Earlier roles',
    entries: [
      {
        period: 'Mar 2021 – Aug 2022',
        company: 'CoderPad',
        role: 'Developer Relations Specialist',
        summary: 'Led developer engagement and the guest-author program.',
      },
      {
        period: 'Apr 2020 – Mar 2021',
        company: 'CooperVision',
        role: 'Frontend Developer',
        summary: 'Built the ordering frontend and shared component system.',
      },
      {
        period: 'May 2019 – Apr 2020',
        company: 'Hilton',
        role: 'Render Tier Engineer',
        summary:
          'Part of the small team that rebuilt Hilton’s search experience.',
      },
      {
        period: 'Jan 2017 – May 2019',
        company: 'Linkd',
        role: 'Full Stack Developer (MEAN)',
        summary: 'Built full-stack web and mobile features.',
      },
      {
        period: 'Feb 2016 – Jan 2017',
        company: 'HCCTS',
        role: 'Sysadmin',
        summary: 'Managed 600+ desktops across 24 locations.',
      },
    ],
  },
  {
    heading: 'Early career side jobs',
    entries: [
      {
        period: 'Jan 2019 – Jan 2020',
        company: 'SacTown Interactive',
        role: 'Lead Developer',
        summary: 'Built Unity gameplay and full-stack web system.',
      },
      {
        period: 'May 2018 – Sep 2018',
        company: 'Trilogy Education',
        role: 'Assistant Instructor',
        summary: 'Helped teach UC Davis’s full-stack bootcamp.',
      },
    ],
  },
];
const earlyCareerCount = earlyCareerGroups.reduce(
  (count, group) => count + group.entries.length,
  0,
);
const earlyCareerDialogId = 'earlier-career-dialog';
---

<section
  class:list={[styles['section'], styles['work-section'], styles['container']]}
  id="work"
  aria-labelledby="work-heading"
  tabindex="-1"
>
  <SectionHeading
    id="work-heading"
    description="Good technical decisions need business context. Good teams need it, too. I bring the architecture, delivery practices, and everyday conversations together so people can do their best work."
    >Work history</SectionHeading
  >

  <div class={styles['career-list']}>
    <details class={styles['career']}>
      <summary>
        <h3 class={styles['career-summary']}>
          <span class={styles['career-period']}>Jun 2026 – Present</span>
          <span class:list={[styles['career-heading'], styles['od-field']]}>
            <span class={styles['career-title']}>Stord</span>
            <span class={styles['role']}>Senior Engineering Manager</span>
          </span>
          <span class={styles['disclosure-icon']} aria-hidden="true"
            ><Icon name="plus"
          /></span>
        </h3>
      </summary>
      <div class={styles['career-body']}>
        <div class={styles['detail-copy']}>
          <p>
            I led Stord’s AI, AI enablement, and Platform teams and oversaw AI
            training for 700 staff.
          </p>
          <div
            class:list={[
              styles['od-grid'],
              styles['metrics'],
              styles['metrics-pair'],
            ]}
            role="group"
            aria-label="Selected work at Stord"
          >
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>13</strong>
              <span class={styles['metric-label']}>Direct reports</span>
            </div>
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>700 staff</strong>
              <span class={styles['metric-label']}>AI training</span>
            </div>
          </div>
          <p class={styles['detail-note']}>
            I ran 1:1s and sprint ceremonies, managed hiring and firing, and
            prepared monthly capital expenditure reports for my teams. I worked
            with product to shape the technical roadmap and shared progress in
            weekly business reviews.
          </p>
          <a class={styles['text-link']} href="https://www.stord.com/"
            ><span>About Stord</span><Icon name="out"
          /></a>
        </div>
      </div>
    </details>
    <details class={styles['career']} open>
      <summary>
        <h3 class={styles['career-summary']}>
          <span class={styles['career-period']}>Apr 2025 – Jun 2026</span>
          <span class:list={[styles['career-heading'], styles['od-field']]}>
            <span class={styles['career-title']}>Immersive Homes</span>
            <span class={styles['role']}
              >Vice President of Software Engineering</span
            >
          </span>
          <span class={styles['disclosure-icon']} aria-hidden="true"
            ><Icon name="plus"
          /></span>
        </h3>
      </summary>
      <div class={styles['career-body']}>
        <div class={styles['detail-copy']}>
          <p>
            I oversaw frontend, backend, DevOps, and QA and led an architectural
            rewrite.
          </p>
          <div
            class:list={[styles['od-grid'], styles['metrics']]}
            role="group"
            aria-label="Selected outcomes at Immersive Homes"
          >
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>
                <span aria-hidden="true">20 → 5 min</span>
                <span class={styles['sr-only']}
                  >Reduced from 20 minutes to 5 minutes</span
                >
              </strong>
              <span class={styles['metric-label']}>Deployment time</span>
            </div>
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>
                <span aria-hidden="true">680+</span>
                <span class={styles['sr-only']}>More than 680</span>
              </strong>
              <span class={styles['metric-label']}>New automated tests</span>
            </div>
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>2 products</strong
              ><span class={styles['metric-label']}
                >Rebuilt in four months</span
              >
            </div>
          </div>
          <p class={styles['detail-note']}>
            I introduced phased rollouts, capacity planning, retrospectives,
            1:1s, and improvements to design handoff and hiring.
          </p>
          <a class={styles['text-link']} href="https://www.immersivehomes.com/"
            ><span>About Immersive Homes</span><Icon name="out"
          /></a>
        </div>
      </div>
    </details>
    <details class={styles['career']}>
      <summary>
        <h3 class={styles['career-summary']}>
          <span class={styles['career-period']}>May 2024 – Apr 2025</span>
          <span class:list={[styles['career-heading'], styles['od-field']]}>
            <span class={styles['career-title']}>Descript</span>
            <span class={styles['role']}>Staff Frontend Engineer</span>
          </span>
          <span class={styles['disclosure-icon']} aria-hidden="true"
            ><Icon name="plus"
          /></span>
        </h3>
      </summary>
      <div class={styles['career-body']}>
        <div class={styles['detail-copy']}>
          <p>
            I migrated a large codebase to React 18 and advised on architecture,
            technology adoption, and tooling across engineering teams.
          </p>
          <div
            class:list={[
              styles['od-grid'],
              styles['metrics'],
              styles['metrics-pair'],
            ]}
            role="group"
            aria-label="Selected work at Descript"
          >
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>
                <span aria-hidden="true">16 → 18</span>
                <span class={styles['sr-only']}>From React 16 to React 18</span>
              </strong>
              <span class={styles['metric-label']}>React migration</span>
            </div>
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>
                <span aria-hidden="true">1.2M lines</span>
                <span class={styles['sr-only']}>1.2 million lines</span>
              </strong>
              <span class={styles['metric-label']}>Codebase migrated</span>
            </div>
          </div>
          <p class={styles['detail-note']}>
            My work also included a performance task force, CI/CD, and
            scaffolding applications within the company’s monorepo.
          </p>
          <a class={styles['text-link']} href="https://www.descript.com/"
            ><span>About Descript</span><Icon name="out"
          /></a>
        </div>
      </div>
    </details>
    <details class={styles['career']}>
      <summary>
        <h3 class={styles['career-summary']}>
          <span class={styles['career-period']}>Aug 2022 – May 2024</span>
          <span class:list={[styles['career-heading'], styles['od-field']]}>
            <span class={styles['career-title']}>NWYC</span>
            <span class={styles['role']}>Staff Frontend Engineer</span>
          </span>
          <span class={styles['disclosure-icon']} aria-hidden="true"
            ><Icon name="plus"
          /></span>
        </h3>
      </summary>
      <div class={styles['career-body']}>
        <div class={styles['detail-copy']}>
          <p>
            I led frontend development across React and React Native
            applications, managed frontend hiring, and worked directly with the
            Director of Technology and CTO. I was promoted from Senior Frontend
            Engineer during my tenure.
          </p>
          <div
            class:list={[
              styles['od-grid'],
              styles['metrics'],
              styles['metrics-pair'],
            ]}
            role="group"
            aria-label="Selected outcomes at NWYC"
          >
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>14 apps</strong>
              <span class={styles['metric-label']}>React and React Native</span>
            </div>
            <div class:list={[styles['od-stat'], styles['metric']]}>
              <strong class={styles['od-nowrap']}>
                <span aria-hidden="true">+350%</span>
                <span class={styles['sr-only']}>350 percent increase</span>
              </strong>
              <span class={styles['metric-label']}
                >Mobile app growth in my first year</span
              >
            </div>
          </div>
          <p class={styles['detail-note']}>
            I also rewrote and redesigned a primary mobile application and
            documented engineering practices for the wider development team.
          </p>
          <a class={styles['text-link']} href="https://nwyc.com/"
            ><span>About NWYC</span><Icon name="out"
          /></a>
        </div>
      </div>
    </details>
  </div>

  <div class={history['groups']}>
    <div class={history['group']}>
      <h3 class={history['group-heading']}>Earlier roles</h3>
      <button
        type="button"
        class:list={[styles['text-link'], history['more-button']]}
        data-dialog-open={earlyCareerDialogId}
        aria-haspopup="dialog"
        aria-controls={earlyCareerDialogId}
        aria-label={`View roles (${earlyCareerCount}) in earlier roles`}
        hidden
      >
        <span>View roles ({earlyCareerCount})</span>
        <Icon name="plus" />
      </button>
      <details
        class={history['fallback']}
        data-dialog-fallback={earlyCareerDialogId}
      >
        <summary>View roles ({earlyCareerCount})</summary>
        {earlyCareerGroups.map((group, index) => (
          <>
            {index > 0 && <h3 class={history['subheading']}>
              {group.heading}
            </h3>}
            <EarlyCareerList
              entries={group.entries}
              headingTag="h4"
              compact={index > 0}
            />
          </>
        ))}
      </details>
      <Dialog id={earlyCareerDialogId} title="Earlier roles">
        {earlyCareerGroups.map((group, index) => (
          <>
            {index > 0 && <h3 class={history['subheading']}>
              {group.heading}
            </h3>}
            <EarlyCareerList
              entries={group.entries}
              headingTag={index === 0 ? 'h3' : 'h4'}
              compact={index > 0}
            />
          </>
        ))}
      </Dialog>
    </div>
  </div>

  <aside
    class={styles['community']}
    aria-labelledby="community-heading"
    data-illustration-trigger
  >
    <div>
      <svg
        class={styles['community-drawing']}
        viewBox="0 0 152 52"
        width="152"
        height="52"
        aria-hidden="true"
        focusable="false"
        fill="none"
        data-illustration
      >
        <path d="M8 26h136M34 6v40M76 6v40M118 6v40" />
        <path
          data-draw
          d="M34 26c0-24 42-24 42 0s42 24 42 0M34 26c0 24 42 24 42 0s42-24 42 0"
        />
        <circle cx="34" cy="26" r="5" data-illustration-node />
        <circle cx="76" cy="26" r="5" data-illustration-node />
        <circle cx="118" cy="26" r="5" data-illustration-node />
      </svg>
      <h3 id="community-heading">Playful Programming</h3>
      <p>
        Executive Director<span aria-hidden="true"> · </span
        ><span class={styles['sr-only']}>, </span>Jun 2019 – present
      </p>
    </div>
    <div>
      <p>
        I oversee development, content, and community for our
        developer-education nonprofit.
      </p>
      <a class={styles['text-link']} href="https://playfulprogramming.com/"
        ><span>Playful Programming website</span><Icon name="out"
      /></a>
    </div>
  </aside>
</section>
