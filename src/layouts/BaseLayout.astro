---
import '../styles/global.css';
import styles from '../styles/site.module.scss';
import IconSprite from '../components/IconSprite.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f9" />
    <meta
      name="description"
      content="Corbin Crutchley is an engineering leader, consultant, author, and open-source maintainer. Thinking of people behind the screen."
    />
    <meta
      property="og:title"
      content="Corbin Crutchley — Thinking of people behind the screen"
    />
    <meta
      property="og:description"
      content="Engineering leadership that connects the business, the codebase, and the people behind both. Explore my work, consulting, writing, and open source."
    />
    <meta property="og:type" content="website" />
    <title>Corbin Crutchley — Thinking of people behind the screen</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23713dc5'/%3E%3Cpath d='M22 9h-8a7 7 0 0 0 0 14h8' fill='none' stroke='white' stroke-width='3'/%3E%3C/svg%3E"
    />
    <link
      rel="preload"
      href="/assets/fonts/manrope-variable.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/assets/fonts/newsreader-italic-variable.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
  </head>
  <body id="top">
    <a class={styles['skip-link']} href="#main">Skip to content</a>
    <IconSprite />
    <slot />
    <script>
      import '../scripts/site';
      import '../scripts/dialogs';
    </script>
  </body>
</html>
