---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Awards from '../components/Awards.astro';
import WorkHistory from '../components/WorkHistory.astro';
import Consulting from '../components/Consulting.astro';
import Writing from '../components/Writing.astro';
import OpenSource from '../components/OpenSource.astro';
import Speaking from '../components/Speaking.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <Hero />
    <Awards />
    <WorkHistory />
    <Consulting />
    <Writing />
    <OpenSource />
    <Speaking />
    <Contact />
  </main>
</BaseLayout>
