{
  "name": "corbin-personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "astro preview",
    "check": "astro check",
    "test:a11y": "npm run build && playwright test",
    "lint": "eslint . && stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.3.5",
    "satori": "0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sass": "1.105.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "wrangler": "4.147.0"
  }
}
